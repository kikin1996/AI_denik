# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Vapi (Voice Agent) ---
VAPI_API_KEY=your-vapi-private-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_WEBHOOK_SECRET=your-vapi-webhook-shared-secret

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- AI Processing ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_PROVIDER=anthropic

# --- iOS VoIP push (mobile app's in-app calls) ---
# Apple Developer -> Certificates, Identifiers & Profiles -> Keys -> create a
# key with "Apple Push Notifications service (APNs)" enabled.
APNS_KEY_ID=your-10-char-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=cz.daystory.app
APNS_ENVIRONMENT=production

# --- Cron ---
CRON_SECRET=change-me-to-a-random-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
